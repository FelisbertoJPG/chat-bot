# Ambiente Python
.venv/
__pycache__/
*.pyc

# Segredos
.env

# Arquivos do assistente de código (uso local, não vão para o repositório)
CLAUDE.md
.claude/

# Conversa em que o projeto foi construído (tem caminhos e dados da máquina)
.conversa/

# Cache das respostas já geradas (refeito sozinho; memoria.md, as respostas validadas, vai no repo)
dados/cache_respostas.json
dados/cache_respostas.tmp

# Rascunhos de mensagem de commit (revisados antes de virar commit)
.commits/

# PDFs originais: são públicos no site do IPASEM e só servem para regerar a pasta dados/
docs/fontes/*.pdf

# Sistema
Thumbs.db
desktop.ini
.DS_Store
