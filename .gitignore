# Ambiente Python
.venv/
__pycache__/
*.pyc

# Segredos
.env

# Arquivos do assistente de código (uso local, não vão para o repositório)
CLAUDE.md
.claude/

# Conversa em que o projeto foi construído (tem caminhos e dados da máquina)
.conversa/

# Cache das respostas já geradas (refeito sozinho; memoria.md, as respostas validadas, vai no repo)
dados/cache_respostas.json
dados/cache_respostas.tmp

# Rascunhos de mensagem de commit (revisados antes de virar commit)
.commits/

# Rede credenciada: nomes, endereços e telefones (inclusive celulares) de profissionais.
# Fica só na máquina até decidir se e como pode ser publicada.
prestadores.json
# Resultados dos evals que usam a rede: as respostas citam nomes de profissionais.
evals/resultados/*rede*
evals/resultados/*hospitais*

# Guia do app e do site: escrito a partir do código do sistema do IPASEM. Fica só na máquina até
# a publicação ser autorizada. O índice e os resultados dos evals do guia copiam o texto dele.
docs/funcionalidades-segurado.md
dados/indice_guia.json
evals/resultados/*guia*
evals/perguntas_guia_respostas.json

# PDFs originais: são públicos no site do IPASEM e só servem para regerar a pasta dados/
docs/fontes/*.pdf

# Sistema
Thumbs.db
desktop.ini
.DS_Store
